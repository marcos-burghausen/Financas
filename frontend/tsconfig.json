{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "src",
    "paths": {
      "@/*": [
        "*"
      ],
      "@services/*": [
        "services/*"
      ],
      "@types/*": [
        "types/*"
      ],
      "@store/*": [
        "store/*"
      ]
    },
    "types": [
      "vuetify",
      "vite/client"
    ],
    "jsx": "preserve",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "env.d.ts",
  ],
  "exclude": [
    "node_modules"
  ]
}