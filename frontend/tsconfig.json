{
  "include": [
    "./src/**/*"
  ],
  "compilerOptions": {
    "module": "es2015",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "es5",
    "sourceMap": true,
    "allowJs": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": [
        "/*"
      ]
    }
  }
}