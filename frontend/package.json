{
  "name": "financas",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "serve": "vite preview --port 3000 --host 0.0.0.0",
    "build-only": "vite build",
    "prebuild": "npm install terser && npm install",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.2.96",
    "@vueuse/core": "^13.9.0",
    "apexcharts": "^4.5.0",
    "axios": "^1.4.0",
    "chart.js": "^4.4.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.13",
    "mdi-vue": "^3.0.13",
    "pinia": "^2.1.6",
    "pinia-plugin-persistedstate": "^3.2.0",
    "vue": "^3.3.4",
    "vue-chartjs": "^5.2.0",
    "vue-currency-input": "^3.1.0",
    "vue-loading-overlay": "^6.0.3",
    "vue-router": "^4.2.4",
    "vue3-apexcharts": "^1.8.0",
    "vuetify": "^3.8.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.19.87",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.0.6",
    "terser": "^5.44.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^2.2.10"
  }
}
